diff --git a/test/unittest/AddonPlaylistTests.cpp b/test/unittest/AddonPlaylistTests.cpp
new file mode 100644
--- /dev/null
+++ b/test/unittest/AddonPlaylistTests.cpp
@@ -0,0 +1,350 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#if HAVE_CONFIG_H
+# include "config.h"
+#endif
+#include "MediaLibrary.h"
+#include "medialibrary/AddonPlaylist.h"
+#include "medialibrary/IMedia.h"
+#include "medialibrary/IFile.h"
+#include "medialibrary/IPlaylist.h"
+#include "database/SqliteTools.h"
+#include "logging/IostreamLogger.h"
+#include "logging/Logger.h"
+#include "utils/Directory.h"
+#include "utils/Filename.h"
+#include "utils/Url.h"
+#include "mocks/FileSystem.h"
+#include <atomic>
+#include <chrono>
+#include <iostream>
+#include <fstream>
+#include <memory>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+
+using namespace medialibrary;
+class TestLibrary : public MediaLibrary {
+public:
+    using MediaLibrary::MediaLibrary;
+    parser::Parser* getParser() const override { return nullptr; }
+    void startDeletionNotifier() override {}
+    void addLocalFsFactory() override {
+        auto factory = std::make_shared<mock::FileSystemFactory>();
+        factory->addDevice(utils::file::toMrl(m_mlFolderPath), "addon-playlist-test", false);
+        factory->addFolder(utils::file::toMrl(m_playlistPath));
+        if (!m_fsHolder.addFsFactory(factory)) throw std::runtime_error("The test filesystem must start.");
+    }
+};
+static void check(bool success, const char* description)
+{ if (!success) throw std::runtime_error(description); }
+static std::unique_ptr<TestLibrary> open(const std::string& directory)
+{
+    auto library = std::unique_ptr<TestLibrary>(new TestLibrary(directory + "/ml.db", directory));
+    check(library->initialize(nullptr) == InitializeResult::Success, "The database must start.");
+    return library;
+}
+static std::vector<int64_t> members(TestLibrary& library, int64_t id)
+{
+    auto context = library.getConn()->acquireReadContext();
+    sqlite::Statement statement("SELECT media_id FROM PlaylistMediaRelation WHERE playlist_id=? ORDER BY position");
+    statement.execute(id); std::vector<int64_t> result;
+    for (auto row = statement.row(); row != nullptr; row = statement.row()) result.push_back(row.extract<int64_t>());
+    return result;
+}
+static std::string counters(TestLibrary& library, int64_t id)
+{
+    auto context = library.getConn()->acquireReadContext();
+    sqlite::Statement statement("SELECT nb_video||','||nb_audio||','||nb_unknown||','||"
+        "nb_present_video||','||nb_present_audio||','||nb_present_unknown||','||"
+        "duration||','||nb_duration_unknown FROM Playlist WHERE id_playlist=?");
+    statement.execute(id); auto row = statement.row();
+    return row == nullptr ? std::string{} : row.extract<std::string>();
+}
+static AddonPlaylistSnapshot snapshot(TestLibrary& library, int64_t id)
+{
+    AddonPlaylistSnapshot value;
+    check(createAddonPlaylistSnapshot(library, id, value), "The snapshot must be available.");
+    return value;
+}
+static void external(const std::string& path, const std::string& sql)
+{
+    sqlite3* db = nullptr;
+    check(sqlite3_open_v2(path.c_str(), &db, SQLITE_OPEN_READWRITE, nullptr) == SQLITE_OK,
+        "The second connection must open.");
+    const auto close = std::unique_ptr<sqlite3, decltype(&sqlite3_close)>(db, sqlite3_close);
+    sqlite3_busy_timeout(db, 5000);
+    check(sqlite3_exec(db, "PRAGMA foreign_keys=ON", nullptr, nullptr, nullptr) == SQLITE_OK,
+        "The second connection must use foreign keys.");
+    check(sqlite3_exec(db, sql.c_str(), nullptr, nullptr, nullptr) == SQLITE_OK,
+        "The second connection must complete its write.");
+}
+int main(int argc, char** argv)
+{
+    if (argc != 2) return 2;
+    Log::SetLogger(std::make_shared<IostreamLogger>()); Log::setLogLevel(LogLevel::Error);
+    const auto directory = std::string(argv[1]) + "-" +
+        std::to_string(std::chrono::steady_clock::now().time_since_epoch().count());
+    try {
+        check(utils::fs::mkdir(directory), "The test directory must be available.");
+        auto library = open(directory);
+        auto first = library->addExternalMedia("file:///cas-first.mkv", 0);
+        auto second = library->addExternalMedia("file:///cas-second.mkv", 0);
+        check(first && second, "The media fixtures must exist.");
+        const auto a = first->id(), b = second->id();
+        unsigned serial = 0, groups = 0; std::string backupDirectory;
+        const auto fixture = [&] {
+            auto playlist = library->createPlaylist("CAS " + std::to_string(++serial));
+            check(playlist && playlist->append(std::vector<int64_t>{a, b}), "The baseline playlist must exist.");
+            return playlist->id();
+        };
+        {
+            const std::string uri = "hakone-addon-source:v1:new-record-title"; int64_t id = -1;
+            check(prepareAddonSourceMedia(*library,uri,"Catalog title",id) && id > 0,
+                "A new source record and its title must commit together.");
+            const auto media = library->media(uri);
+            check(media && media->id() == id && media->title() == "Catalog title", "The new record must have its catalog title.");
+            check(media->setTitle("Manual title"), "The user title must be saved.");
+            int64_t reused = -1;
+            check(prepareAddonSourceMedia(*library,uri,"New catalog title",reused) && reused == id
+                && library->media(uri)->title() == "Manual title", "A reused source record must keep its user title.");
+            ++groups;
+        }
+        {
+            const std::string uri = "hakone-addon-source:v1:failed-title"; int64_t id = -1;
+            sqlite::Tools::executeRequest(library->getConn(),
+                "CREATE TRIGGER IgnoreAddonSourceTitle BEFORE UPDATE OF title ON Media "
+                "WHEN NEW.title='Reject source title' BEGIN SELECT RAISE(IGNORE); END");
+            check(!prepareAddonSourceMedia(*library,uri,"Reject source title",id) && id == 0 && !library->media(uri),
+                "A skipped title update must roll back the new media and file.");
+            sqlite::Tools::executeRequest(library->getConn(),"DROP TRIGGER IgnoreAddonSourceTitle");
+            check(prepareAddonSourceMedia(*library,uri,"Accepted source title",id) && id > 0,
+                "The same source must work after the title failure is removed.");
+            ++groups;
+        }
