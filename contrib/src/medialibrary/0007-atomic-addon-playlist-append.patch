diff --git a/src/AddonPlaylist.cpp b/src/AddonPlaylist.cpp
new file mode 100644
--- /dev/null
+++ b/src/AddonPlaylist.cpp
@@ -0,0 +1,240 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#if HAVE_CONFIG_H
+# include "config.h"
+#endif
+#include "medialibrary/AddonPlaylist.h"
+#include "MediaLibrary.h"
+#include "Playlist.h"
+#include "Media.h"
+#include "File.h"
+#include "utils/ModificationsNotifier.h"
+#include "database/SqliteTools.h"
+#include <algorithm>
+#include <map>
+#include <limits>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+
+namespace medialibrary {
+namespace {
+struct Definition { std::string name, type, sql; };
+const std::vector<Definition>& definitions()
+{
+    static const auto values = [] {
+        std::vector<Definition> result{{"VlcAddonPlaylistRevision", "table",
+            "CREATE TABLE VlcAddonPlaylistRevision (playlist_id INTEGER PRIMARY KEY "
+            "REFERENCES Playlist(id_playlist) ON DELETE CASCADE ON UPDATE CASCADE, "
+            "token TEXT NOT NULL CHECK(length(token)=64))"}};
+        const auto insert = "INSERT OR REPLACE INTO VlcAddonPlaylistRevision(playlist_id,token) VALUES(";
+        const auto change = "UPDATE VlcAddonPlaylistRevision SET token=lower(hex(randomblob(32))) WHERE playlist_id=";
+        const auto trigger = [&](const std::string& name, const std::string& event,
+                                 const std::string& table, const std::string& body) {
+            result.push_back({name, "trigger", "CREATE TRIGGER " + name + " AFTER " + event
+                + " ON " + table + " BEGIN " + body + " END"});
+        };
+        trigger("vlc_addon_playlist_insert", "INSERT", "Playlist",
+            std::string(insert) + "NEW.id_playlist,lower(hex(randomblob(32))));");
+        trigger("vlc_addon_playlist_update", "UPDATE", "Playlist",
+            "DELETE FROM VlcAddonPlaylistRevision WHERE playlist_id=OLD.id_playlist AND OLD.id_playlist!=NEW.id_playlist;"
+            + std::string(insert) + "NEW.id_playlist,lower(hex(randomblob(32))));");
+        trigger("vlc_addon_playlist_delete", "DELETE", "Playlist",
+            "DELETE FROM VlcAddonPlaylistRevision WHERE playlist_id=OLD.id_playlist;");
+        for (const auto& table : {std::string("PlaylistMediaRelation"), std::string("File")}) {
+            const auto prefix = table == "File" ? "vlc_addon_playlist_file_" : "vlc_addon_playlist_member_";
+            trigger(std::string(prefix) + "insert", "INSERT", table,
+                std::string(change) + "NEW.playlist_id;");
+            trigger(std::string(prefix) + "update", "UPDATE", table,
+                std::string(change) + "OLD.playlist_id;" + change + "NEW.playlist_id;");
+            trigger(std::string(prefix) + "delete", "DELETE", table,
+                std::string(change) + "OLD.playlist_id;");
+        }
+        return result;
+    }();
+    return values;
+}
+enum class Schema { Invalid, Stable, Repaired };
+Schema schema(sqlite::Connection* connection)
+{
+    std::vector<const Definition*> missing;
+    for (const auto& expected : definitions()) {
+        sqlite::Statement statement("SELECT type,sql FROM sqlite_master WHERE name=?");
+        statement.execute(expected.name);
+        auto row = statement.row();
+        if (row == nullptr) missing.push_back(&expected);
+        else if (row.extract<std::string>() != expected.type
+            || row.extract<std::string>() != expected.sql || statement.row() != nullptr)
+            return Schema::Invalid;
+    }
+    if (missing.empty()) return Schema::Stable;
+    for (const auto* expected : missing)
+        sqlite::Tools::executeRequest(connection, expected->sql);
+    // Repair must replace every token. The absent trigger may have missed writes.
+    sqlite::Tools::executeRequest(connection, "DELETE FROM VlcAddonPlaylistRevision");
+    sqlite::Tools::executeRequest(connection, "INSERT INTO VlcAddonPlaylistRevision(playlist_id,token) "
+        "SELECT id_playlist,lower(hex(randomblob(32))) FROM Playlist");
+    return Schema::Repaired;
+}
+std::string randomToken()
+{
+    sqlite::Statement statement("SELECT lower(hex(randomblob(32)))");
+    statement.execute();
+    auto row = statement.row();
+    if (row == nullptr) throw std::runtime_error("The playlist token is missing.");
+    return row.extract<std::string>();
+}
+std::string owner(sqlite::Connection* connection)
+{
+    using Weak = std::weak_ptr<sqlite::Connection>;
+    static std::mutex mutex;
+    static std::map<Weak, std::string, std::owner_less<Weak>> owners;
+    std::lock_guard<std::mutex> lock(mutex);
+    for (auto it = owners.begin(); it != owners.end();)
+        if (it->first.expired()) it = owners.erase(it); else ++it;
+    const Weak weak = connection->shared_from_this();
+    const auto found = owners.find(weak);
+    if (found != owners.end()) return found->second;
+    if (owners.size() >= 128) throw std::runtime_error("The playlist owner limit was reached.");
+    return owners.emplace(weak, randomToken()).first->second;
+}
+bool available(int64_t id)
+{
+    sqlite::Statement statement("SELECT 1 FROM Playlist WHERE id_playlist=? AND NOT EXISTS "
+        "(SELECT 1 FROM File WHERE playlist_id=?)");
+    statement.execute(id, id);
+    return statement.row() != nullptr;
+}
+std::string token(int64_t id)
+{
+    sqlite::Statement statement("SELECT token FROM VlcAddonPlaylistRevision WHERE playlist_id=?");
+    statement.execute(id);
+    auto row = statement.row();
+    return row == nullptr ? std::string{} : row.extract<std::string>();
+}
+bool canStart()
+{
+    return !sqlite::Transaction::isInProgress()
+        && !sqlite::Connection::Context::isOpened(sqlite::Connection::Context::Type::Read)
+        && !sqlite::Connection::Context::isOpened(sqlite::Connection::Context::Type::Write);
+}
+bool validToken(const std::string& value)
+{
+    return value.size() == 64 && std::all_of(value.begin(), value.end(),
+        [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); });
+}
+int64_t memberCount(int64_t id)
+{
+    sqlite::Statement statement("SELECT COUNT(*) FROM PlaylistMediaRelation WHERE playlist_id=?");
+    statement.execute(id);
+    auto row = statement.row();
+    if (row == nullptr) throw std::runtime_error("The playlist count is missing.");
+    return row.extract<int64_t>();
+}
+bool completeSuffix(int64_t id, int64_t before, const std::vector<int64_t>& mediaIds)
+{
+    if (memberCount(id) != before + static_cast<int64_t>(mediaIds.size())) return false;
+    sqlite::Statement statement("SELECT media_id,position FROM PlaylistMediaRelation "
+        "WHERE playlist_id=? ORDER BY position LIMIT ? OFFSET ?");
+    statement.execute(id, static_cast<int64_t>(mediaIds.size()) + 1, before);
+    for (size_t index = 0; index < mediaIds.size(); ++index) {
+        auto row = statement.row();
+        if (row == nullptr || row.extract<int64_t>() != mediaIds[index]
+            || row.extract<int64_t>() != before + static_cast<int64_t>(index)) return false;
+    }
+    return statement.row() == nullptr;
+}
+}
+
+bool createAddonPlaylistSnapshot(IMediaLibrary& library, int64_t id,
+                                AddonPlaylistSnapshot& output) noexcept
+{
+    output = {};
+    auto* concrete = dynamic_cast<MediaLibrary*>(&library);
+    if (!concrete || id <= 0 || !canStart()) return false;
+    try {
+        auto* connection = concrete->getConn();
+        auto transaction = connection->newTransaction();
+        if (schema(connection) == Schema::Invalid) return false;
+        // Keep a repair even when this target is no longer available.
+        if (!available(id)) { transaction->commit(); return false; }
+        const auto current = token(id), identity = owner(connection);
+        if (!validToken(current) || !validToken(identity)) return false;
+        AddonPlaylistSnapshot result; result.playlistId = id;
+        std::copy(current.begin(), current.end(), result.token.begin());
+        std::copy(identity.begin(), identity.end(), result.owner.begin());
+        transaction->commit();
+        output = result;
+        return true;
+    } catch (const std::exception&) { return false; }
+}
+
+bool appendAddonPlaylistIfUnchanged(IMediaLibrary& library, const AddonPlaylistSnapshot& snapshot,
+                                   const std::vector<int64_t>& mediaIds) noexcept
+{
+    auto* concrete = dynamic_cast<MediaLibrary*>(&library);
+    if (!concrete || snapshot.playlistId <= 0 || mediaIds.empty() || mediaIds.size() > 1000
+        || std::any_of(mediaIds.begin(), mediaIds.end(), [](int64_t id) { return id <= 0; })
+        || !canStart()) return false;
+    try {
+        auto* connection = concrete->getConn();
+        auto transaction = connection->newTransaction();
+        const auto state = schema(connection);
+        if (state == Schema::Invalid) return false;
+        if (state == Schema::Repaired) { transaction->commit(); return false; }
+        if (!available(snapshot.playlistId)
+            || owner(connection) != std::string(snapshot.owner.begin(), snapshot.owner.end())
+            || token(snapshot.playlistId) != std::string(snapshot.token.begin(), snapshot.token.end())) return false;
+        for (auto id : mediaIds) {
+            sqlite::Statement statement("SELECT 1 FROM Media WHERE id_media=?");
+            statement.execute(id);
+            if (statement.row() == nullptr) return false;
+        }
+        const auto count = memberCount(snapshot.playlistId);
+        if (count < 0 || count > std::numeric_limits<int64_t>::max() - static_cast<int64_t>(mediaIds.size())) return false;
+        // fetch() creates a separate object. Rollback cannot change counters
+        // in a playlist object that another caller holds.
+        auto playlist = Playlist::fetch(concrete, snapshot.playlistId);
+        if (!playlist || !playlist->append(mediaIds)) return false;
+        // A trigger can ignore an insert without an SQL error. Verify the group
+        // before commit. A failure also rolls back counters and revision tokens.
+        if (!completeSuffix(snapshot.playlistId, count, mediaIds)) return false;
+        transaction->commit();
+        return true;
+    } catch (const std::exception&) { return false; }
+}
+
+bool prepareAddonSourceMedia(IMediaLibrary& library, const std::string& uri,
+                            const std::string& title, int64_t& output) noexcept
+{
+    output = 0;
+    auto* concrete = dynamic_cast<MediaLibrary*>(&library);
+    const auto control = [](unsigned char c) { return c < 32 || c == 127; };
+    if (!concrete || !canStart() || uri.size() <= sizeof("hakone-addon-source:v1:") - 1 || uri.size() > 12000
+        || uri.compare(0,sizeof("hakone-addon-source:v1:") - 1,"hakone-addon-source:v1:") != 0
+        || std::any_of(uri.begin(),uri.end(),[&](unsigned char c) { return c == 32 || control(c); })
+        || title.empty() || title.size() > 2048 || std::any_of(title.begin(),title.end(),control)) return false;
+    try {
+        auto* connection = concrete->getConn(); if (!connection) return false;
+        auto transaction = connection->newTransaction();
+        const auto existing = concrete->media(uri);
+        if (existing) { const auto id = existing->id(); transaction->commit(); output = id; return id > 0; }
+        // Defer the creation notification until the whole record commits.
+        const auto now = time(nullptr);
+        const auto id = sqlite::Tools::executeInsert(connection,
+            "INSERT INTO Media(type,duration,insertion_date,title,filename,import_type) VALUES(?,?,?,?,?,?)",
+            IMedia::Type::Unknown,int64_t(-1),now,uri,uri,Media::ImportType::External);
+        if (id <= 0 || !File::createFromExternalMedia(concrete,id,IFile::Type::Main,uri,0,now)) return false;
+        const auto media = Media::fetch(concrete,id);
+        if (!media || !static_cast<IMedia&>(*media).setTitle(title)) return false;
+        sqlite::Statement verify("SELECT 1 FROM Media JOIN File ON File.media_id=Media.id_media "
+            "WHERE Media.id_media=? AND Media.title=? AND File.mrl=? AND File.folder_id IS NULL AND File.type=?");
+        verify.execute(id,title,uri,IFile::Type::Main);
+        if (verify.row() == nullptr || verify.row() != nullptr) return false;
+        transaction->commit(); output = id;
+        // Notification failure cannot undo a completed database commit.
+        try { if (auto notifier = concrete->getNotifier()) notifier->notifyMediaCreation(media); }
+        catch (const std::exception&) {}
+        return true;
+    } catch (const std::exception&) { return false; }
+}
+}
