#define VERSION_NUMBER @HAKONE_VERSION_MAJOR@,@HAKONE_VERSION_MINOR@,@HAKONE_VERSION_REVISION@,0
#define VERSION_NUMBER_STR "@HAKONE_VERSION_MAJOR@,@HAKONE_VERSION_MINOR@,@HAKONE_VERSION_REVISION@,0"

#include <winuser.h>

VLC_ICON ICON "hakone.ico"

1 VERSIONINFO
FILETYPE 1
FILEOS 4
PRODUCTVERSION VERSION_NUMBER
FILEVERSION VERSION_NUMBER
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "Hakone"
      VALUE "ProductName", "Hakone Media Player"
      VALUE "ProductVersion", VERSION_NUMBER_STR
      VALUE "InternalName", "hakone"
      VALUE "OriginalFilename", "hakone.exe"
      VALUE "FileVersion", "@HAKONE_VERSION@"
      VALUE "FileDescription", "Hakone Media Player"
      VALUE "LegalCopyright", "Copyright \251 @COPYRIGHT_YEARS@ VideoLAN and VLC Authors"
      VALUE "LegalTrademarks", "VLC media player, VideoLAN and x264 are registered trademarks from VideoLAN"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "hakone.exe.manifest"
