{
  "formatVersion": 1,
  "id": "org.videolan.thesubtitledb",
  "name": "TheSubtitleDB",
  "version": "0.1.0",
  "publisher": "VLC reference add-ons",
  "license": "GPL-2.0-or-later",
  "source": "https://github.com/dsojevic/juxtopposed-vlc.git",
  "api": {
    "addon": ">=1.0.0 <2.0.0",
    "contracts": {"metadata": "^1.0.0", "settings": "^1.0.0"}
  },
  "runtime": {"kind": "wasm-message-v1", "entry": "dist/addon.wasm"},
  "files": ["addon.json", "LICENSE", "dist/addon.wasm", "settings/schema.json", "settings/ui.json", "locales/en.json"],
  "contributions": [{
    "id": "search",
    "type": "metadata.provider",
    "contract": "metadata@1",
    "features": ["subtitles"],
    "mediaKinds": ["movie", "episode"],
    "operations": ["searchAssets", "resolveAsset"],
    "requires": ["metadata.context", "network.http", "credentials.use"]
  }],
  "permissions": {
    "required": {
      "metadata.context": {"fields": ["kind", "title", "year", "season", "episodes", "ids", "externalIds", "episode", "languages"]},
      "network.http": {"origins": ["https://api.thesubtitledb.org", "https://files.thesubtitledb.org"], "methods": ["GET"]},
      "credentials.use": {"bindings": [{"field": "apiKey", "origin": "https://api.thesubtitledb.org", "header": "Authorization", "prefix": "Bearer "}]}
    },
    "optional": {}
  },
  "settings": {"version": 1, "schema": "settings/schema.json", "ui": "settings/ui.json"},
  "locales": {"default": "en", "files": {"en": "locales/en.json"}}
}
