{
  "formatVersion": 1,
  "id": "org.videolan.lastfm",
  "name": "Last.fm artwork",
  "version": "0.1.1",
  "publisher": "Hakone core",
  "license": "GPL-2.0-or-later",
  "source": "https://github.com/hakone-org/addon-lastfm.git",
  "api": {
    "addon": ">=1.0.0 <2.0.0",
    "contracts": {
      "metadata": "^1.0.0"
    }
  },
  "runtime": {
    "kind": "wasm-message-v1",
    "entry": "dist/addon.wasm"
  },
  "files": [
    "addon.json",
    "LICENSE",
    "NOTICE.md",
    "dist/addon.wasm",
    "THIRD_PARTY_NOTICES.md"
  ],
  "contributions": [
    {
      "id": "artwork",
      "type": "metadata.provider",
      "contract": "metadata@1",
      "features": [
        "artwork"
      ],
      "mediaKinds": [
        "unknown",
        "movie",
        "episode",
        "musicTrack",
        "album",
        "artist",
        "podcast",
        "podcastEpisode",
        "audiobook"
      ],
      "operations": [
        "enrich",
        "searchAssets",
        "resolveAsset"
      ],
      "requires": [
        "metadata.context",
        "network.http"
      ]
    }
  ],
  "permissions": {
    "required": {
      "metadata.context": {
        "fields": [
          "kind",
          "type",
          "title",
          "year",
          "artist",
          "albumArtist",
          "album",
          "ids",
          "release"
        ]
      },
      "network.http": {
        "origins": [
          "https://www.last.fm",
          "https://lastfm-img.freetls.fastly.net",
          "https://lastfm.freetls.fastly.net",
          "https://lastfm-img2.akamaized.net"
        ],
        "methods": [
          "GET"
        ]
      }
    },
    "optional": {}
  }
}
